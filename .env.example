# Copy to .env and fill in. .env is gitignored.

# ── LLM ────────────────────────────────────────────────────────────────
# LiteLLM reads ANTHROPIC_API_KEY directly from the environment.
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_MODEL=anthropic/claude-sonnet-4-6
# Tool-use round budget. A capped run makes one extra tool-free synthesis call.
AGENT_MAX_ROUNDS_WITH_TOOL_CALLS=10

# ── Compaction ─────────────────────────────────────────────────────────
# Cumulative input-token threshold before in-session compaction runs.
COMPACTION_TRIGGER_TOKENS=20000
COMPACTION_PRESERVE_RECENT=4

# ── Postgres ───────────────────────────────────────────────────────────
# The agent service talks to pgbouncer; pgbouncer talks to postgres.
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
POSTGRES_DB=anthelion
POSTGRES_USER=anthelion
POSTGRES_PASSWORD=anthelion_dev_pw
# Read-only role used by the agent's load_dataset_sql tool.
POSTGRES_READONLY_USER=anthelion_ro
POSTGRES_READONLY_PASSWORD=anthelion_ro_dev_pw

# ── Agent datasets + SQL safety ────────────────────────────────────────
# Statement timeout for the read-only pool used by load_dataset_sql.
AGENT_SQL_STATEMENT_TIMEOUT_MS=10000
# Max rows a loader pulls into a server-side dataset (RAM guard, not a context cap).
AGENT_DATASET_MAX_ROWS=200000
# Rows shown in a dataset's head sample (the metadata the agent sees).
AGENT_DATASET_HEAD_ROWS=5
# Max rows dataset_sample returns in one call.
AGENT_DATASET_SAMPLE_MAX=50

# ── Service ────────────────────────────────────────────────────────────
AGENT_SERVICE_PORT=8000
